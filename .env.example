# ==============================================================================
# WinSecure Environment Configuration Template (.env.example)
# Note: WinSecure is 100% offline & zero-cloud by default. No API keys required.
# ==============================================================================

# Execution Logging Level (DEBUG, INFO, WARNING, ERROR)
WINSECURE_LOG_LEVEL=INFO

# Default Scan Profile (standard, hardened, quick, full)
WINSECURE_DEFAULT_PROFILE=standard

# Custom Report Output Path (Optional)
# WINSECURE_OUTPUT_DIR=./WinSecure-Report
