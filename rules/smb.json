    "check_params": {
      "hive": "HKLM",
      "subkey": "SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
      "value": "RequireSecuritySignature",
      "expected": 1
    },
    "compliance_mappings": [
      {"framework": "CIS Windows 11 Enterprise", "version": "5.0.1", "control_id": "2.3.8.1", "title": "Ensure 'Microsoft network server: Digitally sign communications (always)' is set to 'Enabled'"},
      {"framework": "NIST SP 800-53", "version": "Rev 5", "control_id": "SC-8", "title": "Transmission Confidentiality and Integrity"}
    ],
    "mitre_attack": ["T1557.001"],
