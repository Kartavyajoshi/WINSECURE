[
  {
    "id": "WS-SMB-001",
    "title": "SMBv1 Legacy Protocol is Enabled",
    "category": "SMB",
    "severity": "Critical",
    "description": "SMBv1 lacks modern security protections and contains critical vulnerabilities exploited by EternalBlue, WannaCry, and NotPetya.",
    "expected": "SMB1 = 0 or Disabled",
    "impact": "Remote unauthenticated code execution and lateral movement via legacy protocol vulnerabilities.",
    "remediation_guidance": "Disable SMBv1: Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol or Set-SmbServerConfiguration -EnableSMB1Protocol $false",
    "check_type": "registry",
    "check_params": {
      "hive": "HKLM",
      "subkey": "SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
      "value": "SMB1",
      "expected": 0
    },
    "compliance_mappings": [
      {"framework": "CIS Windows 11 Enterprise", "version": "5.0.1", "control_id": "18.4.1", "title": "Ensure SMBv1 protocol is disabled"},
      {"framework": "NIST SP 800-53", "version": "Rev 5", "control_id": "CM-7", "title": "Least Functionality"},
      {"framework": "Microsoft Security Baseline", "version": "Win11-23H2", "control_id": "MS-SMB-01", "title": "Disable SMBv1"}
    ],
    "mitre_attack": ["T1210"],
    "references": ["https://learn.microsoft.com/en-us/windows-server/storage/file-server/troubleshoot/detect-enable-and-disable-smbv1-v2-v3"],
    "requires_admin": true
  },
  {
    "id": "WS-SMB-002",
    "title": "SMB Server Packet Signing is Not Required",
    "category": "SMB",
    "severity": "High",
